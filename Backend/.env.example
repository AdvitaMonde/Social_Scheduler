# --- Server ---
PORT=4000
BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/ai-social-scheduler

# --- Auth ---
# The frontend signs users in with Firebase Auth and sends a Firebase ID
# token on every request; the backend verifies it with the Firebase Admin
# SDK. Get this from Firebase Console -> Project Settings -> Service
# Accounts -> Generate new private key, then:
#   base64 -i serviceAccountKey.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=replace_with_base64_encoded_service_account_json

# Only used internally if you add your own JWT-based flows later — not
# used to verify the frontend's Firebase tokens.
JWT_SECRET=replace_with_a_long_random_string

# --- Meta App (from developers.facebook.com, server-side ONLY) ---
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:4000/api/meta/callback
#META_REDIRECT_URI=https://founder-spied-freestyle.ngrok-free.dev/api/meta/callback
META_GRAPH_VERSION=v20.0

# --- Token encryption (32-byte key, base64 or hex encoded) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=replace_with_64_hex_chars_32_bytes
